/* components/chart-placeholder/chart-placeholder.wxss */
.chart-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border: 2rpx dashed #dee2e6;
  border-radius: 12rpx;
  margin: 20rpx;
}

.placeholder-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.6;
}

.loading-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  animation: pulse 1.5s infinite;
}

.loading-text {
  font-size: 24rpx;
  color: #6c757d;
}

@keyframes pulse {
  0% {
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.6;
  }
}
