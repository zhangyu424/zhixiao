.vscode/
project.private.config.json
sitemap.json

# 日志文件
*.log
*.logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 依赖目录
node_modules/
miniprogram_npm/

# 临时文件
*.tmp
*.temp
.DS_Store
Thumbs.db

# 编译生成的文件
dist/
build/

# 用户配置
.env
.env.local
.env.development
.env.production

# IDE配置
.idea/
*.swp
*.swo

# 备份文件
*.bak
*.backup

# 测试覆盖率报告
coverage/

# ESLint缓存
.eslintcache

# Prettier缓存
.prettiercache

# 性能分析文件
*.cpuprofile
*.heapprofile

