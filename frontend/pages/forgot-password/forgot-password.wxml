<!--pages/forgot-password/forgot-password.wxml-->
<view class="forgot-password-container">
  <!-- 头部 -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="title">
      <text class="title-text">忘记密码</text>
      <text class="title-desc">通过手机号验证找回密码</text>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-container">
    <!-- 学号输入 -->
    <view class="form-field">
      <view class="field-label">学号</view>
      <input 
        class="field-input"
        placeholder="请输入您的学号"
        value="{{form.student_id}}"
        bindinput="onStudentIdInput"
        maxlength="20"
      />
    </view>

    <!-- 手机号输入 -->
    <view class="form-field">
      <view class="field-label">手机号</view>
      <input 
        class="field-input"
        placeholder="请输入绑定的手机号"
        value="{{form.phone}}"
        bindinput="onPhoneInput"
        type="number"
        maxlength="11"
      />
    </view>

    <!-- 验证码输入 -->
    <view class="form-field">
      <view class="field-label">验证码</view>
      <view class="code-input-group">
        <input 
          class="field-input code-input"
          placeholder="请输入验证码"
          value="{{form.verificationCode}}"
          bindinput="onCodeInput"
          type="number"
          maxlength="6"
        />
        <button 
          class="code-btn"
          bindtap="sendVerificationCode"
          disabled="{{codeStatus.loading || codeStatus.countdown > 0}}"
          loading="{{codeStatus.loading}}"
        >
          {{codeStatus.text}}
        </button>
      </view>
    </view>

    <!-- 新密码输入 -->
    <view class="form-field">
      <view class="field-label">新密码</view>
      <input 
        class="field-input"
        placeholder="请输入新密码，至少6位"
        value="{{form.newPassword}}"
        bindinput="onNewPasswordInput"
        password
        maxlength="20"
      />
    </view>

    <!-- 确认密码输入 -->
    <view class="form-field">
      <view class="field-label">确认密码</view>
      <input 
        class="field-input"
        placeholder="请再次输入新密码"
        value="{{form.confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        password
        maxlength="20"
      />
    </view>

    <!-- 重置按钮 -->
    <view class="submit-section">
      <button 
        class="reset-btn"
        bindtap="resetPassword"
        loading="{{resetLoading}}"
        disabled="{{resetLoading}}"
      >
        {{resetLoading ? '重置中...' : '重置密码'}}
      </button>
    </view>
  </view>

  <!-- 提示信息 -->
  <view class="tips">
    <text class="tip-text">• 验证码将发送到您绑定的手机号</text>
    <text class="tip-text">• 新密码需要至少6位字符</text>
    <text class="tip-text">• 如有问题请联系管理员</text>
  </view>
</view>
