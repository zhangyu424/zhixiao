/* pages/forgot-password/forgot-password.wxss */
.forgot-password-container {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 0 40rpx;
}

/* 头部 */
.header {
  padding: 80rpx 0 60rpx;
  position: relative;
}

.back-btn {
  position: absolute;
  left: 0;
  top: 80rpx;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.title {
  text-align: center;
  margin-top: 20rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 15rpx;
}

.title-desc {
  font-size: 28rpx;
  color: #666;
}

/* 表单 */
.form-container {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.form-field {
  margin-bottom: 40rpx;
}

.form-field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #667eea;
  background: #fff;
}

.field-input::placeholder {
  color: #adb5bd;
}

/* 验证码输入组 */
.code-input-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-btn:disabled {
  background: #ced4da;
  color: #6c757d;
}

.code-btn::after {
  border: none;
}

/* 提交区域 */
.submit-section {
  margin-top: 60rpx;
}

.reset-btn {
  width: 100%;
  height: 100rpx;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.reset-btn:disabled {
  background: #ced4da;
}

.reset-btn::after {
  border: none;
}

/* 提示信息 */
.tips {
  padding: 40rpx 20rpx;
}

.tip-text {
  display: block;
  font-size: 26rpx;
  color: #6c757d;
  line-height: 2;
  margin-bottom: 10rpx;
}
