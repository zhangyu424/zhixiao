/* pages/analysis/analysis.wxss */

.analysis-container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 筛选条件 */
.filter-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.filter-item {
  margin-bottom: 24rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.picker-display {
  padding: 20rpx 24rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  background: #fff;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.view-tabs {
  display: flex;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 6rpx;
  margin-top: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 6rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: #1890ff;
  color: #fff;
}

/* 加载状态 */
.loading-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: spin 2s linear infinite;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 通用区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.export-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.export-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 概览数据 */
.overview-section {
  margin-bottom: 20rpx;
}

.overview-cards {
  display: flex;
  margin: -10rpx;
}

.overview-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin: 10rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.card-title {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.card-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.card-change {
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-change.positive {
  color: #52c41a;
}

.card-change.negative {
  color: #ff4d4f;
}

.card-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 图表区域 */
.charts-section {
  margin-bottom: 20rpx;
}

.chart-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chart-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.chart-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.chart-export {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  font-size: 24rpx;
  color: #666;
}

.chart-container {
  padding: 30rpx;
}

.chart-placeholder {
  height: 400rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ddd;
}

.chart-placeholder text:first-child {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.chart-desc {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 热力图 */
.heatmap-container {
  padding: 20rpx;
}

.heatmap-legend {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 24rpx;
}

.legend-label {
  color: #666;
  margin-right: 20rpx;
}

.legend-colors {
  display: flex;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.color-block {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  margin-right: 8rpx;
}

.color-block.level-0 {
  background: #f0f0f0;
}

.color-block.level-1 {
  background: #c6e48b;
}

.color-block.level-2 {
  background: #7bc96f;
}

.color-block.level-3 {
  background: #239a3b;
}

.heatmap-grid {
  display: flex;
  flex-direction: column;
}

.heatmap-week {
  display: flex;
  margin-bottom: 4rpx;
}

.heatmap-day {
  width: 32rpx;
  height: 32rpx;
  margin-right: 4rpx;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #fff;
}

.heatmap-day.level-0 {
  background: #f0f0f0;
  color: #999;
}

.heatmap-day.level-1 {
  background: #c6e48b;
}

.heatmap-day.level-2 {
  background: #7bc96f;
}

.heatmap-day.level-3 {
  background: #239a3b;
}

/* 排名列表 */
.ranking-list {
  padding: 20rpx 0;
}

.ranking-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ranking-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #666;
  margin-right: 20rpx;
}

.rank-number.top-rank {
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  color: #fff;
}

.member-info {
  flex: 1;
}

.member-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.member-unit {
  font-size: 24rpx;
  color: #999;
}

.member-stats {
  display: flex;
}

.stat-item {
  text-align: center;
  margin-left: 30rpx;
}

.stat-value {
  display: block;
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 600;
  line-height: 1;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

/* 分析结论 */
.conclusion-section {
  margin-bottom: 20rpx;
}

.conclusion-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.conclusion-content {
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.conclusion-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

.suggestions-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.suggestion-list {
  padding-left: 20rpx;
}

.suggestion-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

/* 空状态 */
.empty-state {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #ccc;
}
