/* pages/unit-select/unit-select.wxss */
.unit-select-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.unit-list {
  background-color: white;
  border-radius: 10rpx;
  overflow: hidden;
}

.unit-item {
  display: flex;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.unit-item:last-child {
  border-bottom: none;
}

.unit-item.selected {
  background-color: #e6f7ff;
}

.unit-name {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.unit-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
}

.selected-icon {
  font-size: 36rpx;
  color: #1890ff;
}

.confirm-btn {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  background-color: #1890ff;
  color: white;
  border-radius: 10rpx;
  padding: 26rpx;
  text-align: center;
  font-size: 32rpx;
}

.confirm-btn.disabled {
  background-color: #d9d9d9;
  color: #999;
}
