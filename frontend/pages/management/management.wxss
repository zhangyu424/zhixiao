/* pages/management/management.wxss */

.management-container {
  padding-bottom: 120rpx;
}

/* 标签栏 */
.tab-bar {
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-list {
  display: flex;
  padding: 0 20rpx;
}

.tab-item {
  flex-shrink: 0;
  padding: 30rpx 40rpx;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  color: #1890ff;
  border-bottom-color: #1890ff;
  font-weight: 500;
}

/* 内容区域 */
.tab-content {
  padding: 20rpx;
}

.content-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

/* 表单组件 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.picker-display {
  padding: 20rpx 24rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  background: #fff;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

/* 数据导入 */
.template-section,
.file-section,
.import-section {
  margin-bottom: 40rpx;
}

.template-title,
.file-title,
.import-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.template-btn {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  color: #1890ff;
  border: 2rpx solid #1890ff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.file-chooser {
  border: 2rpx dashed #d9d9d9;
  border-radius: 8rpx;
  padding: 40rpx;
  text-align: center;
  background: #fafafa;
}

.file-info {
  display: flex;
  align-items: center;
  justify-content: center;
}

.file-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.file-details {
  text-align: left;
}

.file-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.file-size {
  font-size: 24rpx;
  color: #999;
}

.file-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 28rpx;
  color: #999;
}

.import-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.import-btn.disabled {
  background: #f0f0f0;
  color: #999;
}

/* 导入结果 */
.import-result {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}

.result-header {
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.result-stats {
  display: flex;
  margin-bottom: 20rpx;
}

.result-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.result-item:last-child {
  margin-right: 0;
}

.result-item.success {
  background: #f6ffed;
  color: #52c41a;
}

.result-item.warning {
  background: #fff7e6;
  color: #fa8c16;
}

.result-item.error {
  background: #fff2f0;
  color: #ff4d4f;
}

.result-label {
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.result-value {
  font-size: 32rpx;
  font-weight: 600;
}

.error-list {
  margin-top: 20rpx;
}

.error-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.error-item {
  background: #fff;
  border-radius: 4rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
}

.error-row {
  color: #ff4d4f;
  font-weight: 500;
}

.error-message {
  color: #666;
  margin-left: 8rpx;
}

/* 数据导出 */
.export-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 30rpx;
}

.export-btn.loading {
  background: #f0f0f0;
  color: #999;
}

/* 组织管理 */
.org-actions {
  display: flex;
  margin-bottom: 30rpx;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
}

.action-btn.primary {
  background: #1890ff;
  color: #fff;
}

.action-btn.secondary {
  background: #f0f0f0;
  color: #666;
}

.action-btn.danger {
  background: #ff4d4f;
  color: #fff;
}

.action-btn.disabled {
  background: #f5f5f5;
  color: #ccc;
}

.organization-tree {
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.tree-node {
  border-bottom: 1rpx solid #f0f0f0;
}

.tree-node:last-child {
  border-bottom: none;
}

.tree-node.selected .node-content {
  background: #e6f7ff;
}

.node-content {
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.node-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.node-level {
  font-size: 24rpx;
  color: #999;
}

.child-nodes {
  background: #fafafa;
}

.child-node {
  padding: 16rpx 60rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #f0f0f0;
}

.child-node.selected {
  background: #e6f7ff;
}

.child-name {
  font-size: 26rpx;
  color: #666;
}

.child-level {
  font-size: 22rpx;
  color: #999;
}

/* 用户管理 */
.user-actions {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  gap: 20rpx;
}

.search-box {
  flex: 1;
}

.search-input {
  width: 100%;
  height: 64rpx;
  padding: 0 20rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.add-user-btn {
  width: 160rpx;
  height: 64rpx;
  background: #1890ff;
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.user-list {
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.user-item {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.user-item:last-child {
  border-bottom: none;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}

.user-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 40rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.user-role {
  display: inline-block;
  font-size: 22rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.user-unit {
  font-size: 22rpx;
  color: #666;
}

.edit-user-btn {
  width: 100rpx;
  height: 60rpx;
  background: #f0f0f0;
  color: #666;
  border: none;
  border-radius: 6rpx;
  font-size: 24rpx;
}

/* 系统设置 */
.settings-form {
  padding: 20rpx 0;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-label {
  font-size: 28rpx;
  color: #333;
}

.time-display {
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 6rpx;
  font-size: 28rpx;
  color: #333;
}

.setting-input {
  width: 120rpx;
  padding: 12rpx 16rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 6rpx;
  font-size: 28rpx;
  text-align: center;
}

.save-settings-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 40rpx;
}
