<!--pages/api-sync-status/api-sync-status.wxml-->
<view class="container">
  <view class="header">
    <text class="title">API同步状态</text>
    <text class="subtitle">与后端接口同步管理</text>
  </view>

  <!-- 同步状态概览 -->
  <view class="status-card">
    <view class="card-header">
      <text class="card-title">同步状态</text>
      <button class="refresh-btn" bind:tap="refreshStatus" size="mini">刷新</button>
    </view>
    
    <view class="status-info">
      <view class="status-item">
        <text class="label">最后同步:</text>
        <text class="value">{{syncStatus.lastSync || '从未同步'}}</text>
      </view>
      <view class="status-item">
        <text class="label">同步状态:</text>
        <text class="value status-{{syncStatus.status}}">{{getStatusText(syncStatus.status)}}</text>
      </view>
      <view class="status-item">
        <text class="label">待处理更新:</text>
        <text class="value">{{syncStatus.pendingUpdates}}项</text>
      </view>
      <view class="status-item">
        <text class="label">错误数量:</text>
        <text class="value">{{syncStatus.errors}}个</text>
      </view>
    </view>
  </view>

  <!-- API兼容性 -->
  <view class="status-card" wx:if="{{compatibility}}">
    <view class="card-header">
      <text class="card-title">API兼容性</text>
      <view class="compatibility-status status-{{compatibility.overall}}">
        {{getStatusText(compatibility.overall)}}
      </view>
    </view>
    
    <view class="compatibility-details" wx:if="{{compatibility.details}}">
      <view class="detail-item" wx:for="{{compatibility.details}}" wx:key="category">
        <text class="category">{{item.category}}</text>
        <view class="status status-{{item.status}}">{{item.status}}</view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="sync-btn" bind:tap="executeSync" type="primary">
      执行API同步
    </button>
    <button class="check-btn" bind:tap="checkCompatibility" loading="{{isLoading}}">
      检查兼容性
    </button>
    <button class="export-btn" bind:tap="exportAPIDoc">
      导出API文档
    </button>
  </view>

  <!-- 同步历史 -->
  <view class="history-section">
    <view class="section-header">
      <text class="section-title">同步历史</text>
      <button class="clear-btn" bind:tap="clearHistory" size="mini">清除</button>
    </view>
    
    <view class="history-list" wx:if="{{syncHistory.length > 0}}">
      <view class="history-item" wx:for="{{syncHistory}}" wx:key="timestamp"
            bind:tap="viewSyncDetail" data-index="{{index}}">
        <view class="history-time">{{item.timestamp}}</view>
        <view class="history-status status-{{item.status}}">
          {{getStatusText(item.status)}}
        </view>
      </view>
    </view>
    
    <view class="empty-state" wx:else>
      <text>暂无同步历史</text>
    </view>
  </view>

  <!-- 最后更新时间 -->
  <view class="footer">
    <text class="update-time">最后更新: {{lastUpdate}}</text>
  </view>
</view>
