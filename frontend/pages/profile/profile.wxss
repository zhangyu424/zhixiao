/* pages/profile/profile.wxss */

.profile-container {
  padding: 20rpx;
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 用户信息卡片 */
.user-info-card {
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.user-avatar-section {
  position: relative;
  margin-right: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-edit-icon {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-icon {
  width: 20rpx;
  height: 20rpx;
}

.user-details {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.user-id {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 16rpx;
}

.current-role,
.user-unit {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.role-label,
.unit-label {
  opacity: 0.8;
  margin-right: 8rpx;
}

.role-value,
.unit-value {
  opacity: 1;
  font-weight: 500;
}

.role-switch-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  font-size: 24rpx;
  width: fit-content;
}

.switch-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

/* 通用区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.view-detail {
  font-size: 26rpx;
  color: #1890ff;
}

/* 个人统计 */
.stats-section {
  margin-bottom: 20rpx;
}

.stats-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-item {
  text-align: center;
}

.stats-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}

/* 快捷功能 */
.quick-functions {
  margin-bottom: 20rpx;
}

.function-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.function-item {
  padding: 30rpx 20rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f8f9fa;
}

.function-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 16rpx;
}

.function-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.function-desc {
  font-size: 24rpx;
  color: #666;
}

/* 设置选项 */
.settings-section {
  margin-bottom: 20rpx;
}

.settings-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}

.setting-content {
  flex: 1;
}

.setting-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: #999;
}

.setting-arrow {
  font-size: 28rpx;
  color: #ccc;
  font-weight: bold;
}

/* 退出登录 */
.logout-section {
  margin-bottom: 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.logout-btn:active {
  background: #fff2f0;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 20rpx;
}

.version-text {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.copyright {
  font-size: 22rpx;
  color: #ccc;
}
