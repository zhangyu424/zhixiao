/* pages/unified-login/unified-login.wxss */

.unified-login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
  box-sizing: border-box;
  position: relative;
}

/* ========== 头部区域 ========== */
.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

.app-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.app-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.app-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* ========== 登录方式切换 ========== */
.login-type-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
  padding: 8rpx;
  margin-bottom: 60rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border-radius: 42rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tab-item.active {
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}

.tab-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #333333;
  font-weight: 600;
}

/* ========== 登录表单容器 ========== */
.login-form-container {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  margin-bottom: 40rpx;
}

/* ========== 表单标题 ========== */
.form-title {
  text-align: center;
  margin-bottom: 50rpx;
}

.title-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.title-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

/* ========== 表单字段 ========== */
.form-fields {
  margin-bottom: 50rpx;
}

.form-field {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 24rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.form-field:focus-within {
  background: #ffffff;
  border-color: #1890ff;
  box-shadow: 0 0 0 6rpx rgba(24, 144, 255, 0.1);
}

.field-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  color: #999999;
  min-width: 32rpx;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #333333;
  background: transparent;
  border: none;
  outline: none;
}

.field-input::placeholder {
  color: #999999;
}

.field-action {
  margin-left: 20rpx;
  padding: 8rpx;
  cursor: pointer;
}

.action-icon {
  font-size: 32rpx;
  color: #999999;
}

/* ========== 验证码字段特殊样式 ========== */
.captcha-field {
  position: relative;
}

.captcha-input {
  padding-right: 200rpx;
}

.captcha-btn {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #1890ff;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  min-width: 160rpx;
  height: 60rpx;
  line-height: 1;
}

.captcha-btn.disabled {
  background: #d9d9d9;
  color: #999999;
}

/* ========== 表单按钮 ========== */
.form-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
  margin-bottom: 30rpx;
}

.login-btn.primary {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  color: #ffffff;
}

.login-btn.wechat {
  background: linear-gradient(135deg, #07c160, #1aad19);
  color: #ffffff;
}

.login-btn.loading {
  opacity: 0.7;
  transform: scale(0.98);
}

.login-btn:active {
  transform: scale(0.95);
}

.btn-icon, .loading-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.loading-icon {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.forgot-password {
  cursor: pointer;
}

.forgot-text {
  font-size: 26rpx;
  color: #1890ff;
  text-decoration: underline;
}

/* ========== 微信登录特殊样式 ========== */
.wechat-info {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #f0f9ff;
  border-radius: 20rpx;
  border: 1rpx solid #b3d8ff;
}

.user-preview {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  margin-right: 24rpx;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.auth-status {
  font-size: 24rpx;
  color: #52c41a;
}

.wechat-tips {
  display: flex;
  align-items: flex-start;
  padding: 30rpx;
  background: #f6f8fa;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.tips-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 12rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

/* ========== 用户协议 ========== */
.user-agreement {
  margin-bottom: 40rpx;
}

.agreement-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  line-height: 1.6;
}

.agreement-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin: 0 8rpx;
}

.agreement-link {
  font-size: 24rpx;
  color: #40a9ff;
  text-decoration: underline;
  margin: 0 4rpx;
}

/* ========== 开发面板 ========== */
.dev-panel {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.dev-header {
  margin-bottom: 20rpx;
}

.dev-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.dev-actions {
  display: flex;
  gap: 20rpx;
}

.dev-btn {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* ========== 底部信息 ========== */
.login-footer {
  text-align: center;
  margin-top: 60rpx;
}

.version-info {
  margin-bottom: 16rpx;
}

.version-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.company-info {
  margin-top: 8rpx;
}

.company-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 账号绑定弹窗 ========== */
.binding-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(5rpx);
}

.modal-content {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 40rpx 0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.modal-close {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #999999;
  cursor: pointer;
}

.modal-body {
  padding: 30rpx 40rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.modal-tips {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.5;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 40rpx 40rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666666;
}

.modal-btn.confirm {
  background: #1890ff;
  color: #ffffff;
}

/* ========== 响应式适配 ========== */
@media (max-width: 750rpx) {
  .unified-login-container {
    padding: 40rpx 30rpx 30rpx;
  }
  
  .login-form-container {
    padding: 40rpx 30rpx;
  }
  
  .tab-item {
    padding: 20rpx 12rpx;
  }
  
  .tab-text {
    font-size: 22rpx;
  }
}

/* ========== 深色模式适配 ========== */
@media (prefers-color-scheme: dark) {
  .login-form-container {
    background: rgba(30, 30, 30, 0.95);
    border: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .title-text {
    color: #ffffff;
  }
  
  .title-desc {
    color: rgba(255, 255, 255, 0.7);
  }
  
  .form-field {
    background: rgba(255, 255, 255, 0.1);
  }
  
  .form-field:focus-within {
    background: rgba(255, 255, 255, 0.15);
  }
  
  .field-input {
    color: #ffffff;
  }
  
  .field-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
}
