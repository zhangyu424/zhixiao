/* pages/account-binding/account-binding.wxss */

.binding-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 0 0 120rpx;
}

/* ========== 头部区域 ========== */
.binding-header {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.2);
  padding: 20rpx 0 40rpx;
}

.header-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 40rpx 0;
}

.nav-back, .nav-help {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  cursor: pointer;
}

.back-icon, .help-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
}

.nav-title {
  flex: 1;
  text-align: center;
}

.title-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ========== 步骤指示器 ========== */
.step-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 60rpx 0;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-number {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-item.active .step-number {
  background: #1890ff;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

.step-item.completed .step-number {
  background: #52c41a;
  color: #ffffff;
}

.step-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  text-align: center;
}

.step-item.active .step-text {
  color: #ffffff;
  font-weight: 600;
}

.step-line {
  width: 100rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
  margin-top: -42rpx;
  transition: all 0.3s ease;
}

.step-line.active {
  background: #1890ff;
}

/* ========== 微信用户信息 ========== */
.wechat-user-info {
  padding: 40rpx;
}

.user-card {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50rpx;
  margin-right: 30rpx;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.bind-desc {
  font-size: 26rpx;
  color: #666666;
}

/* ========== 步骤内容 ========== */
.step-content {
  padding: 0 40rpx;
  min-height: 600rpx;
}

/* ========== 绑定方式选择 ========== */
.binding-methods {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.method-title {
  text-align: center;
  margin-bottom: 50rpx;
}

.method-title .title-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.method-title .title-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.method-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.method-item {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 20rpx;
  padding: 30rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  cursor: pointer;
}

.method-item:active {
  background: #e6f7ff;
  border-color: #1890ff;
  transform: scale(0.98);
}

.method-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  width: 48rpx;
  text-align: center;
}

.method-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.method-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.method-desc {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.method-arrow {
  font-size: 32rpx;
  color: #999999;
  font-weight: 600;
}

/* ========== 绑定表单 ========== */
.binding-form {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.form-title {
  text-align: center;
  margin-bottom: 50rpx;
}

.form-title .title-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.form-title .title-desc {
  display: block;
  font-size: 26rpx;
  color: #666666;
}

.form-fields {
  margin-bottom: 50rpx;
}

.form-field {
  margin-bottom: 40rpx;
}

.field-label {
  margin-bottom: 16rpx;
}

.label-text {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.label-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.field-input-wrapper {
  position: relative;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  color: #333333;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.field-input:focus {
  background: #ffffff;
  border-color: #1890ff;
  box-shadow: 0 0 0 6rpx rgba(24, 144, 255, 0.1);
}

.field-input::placeholder {
  color: #999999;
}

/* ========== 密码输入特殊样式 ========== */
.password-wrapper {
  position: relative;
}

.password-toggle {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  padding: 8rpx;
}

.toggle-icon {
  font-size: 32rpx;
  color: #999999;
}

/* ========== 验证码输入特殊样式 ========== */
.captcha-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.captcha-input {
  flex: 1;
}

.captcha-btn {
  background: #1890ff;
  color: #ffffff;
  border: none;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  font-size: 24rpx;
  min-width: 180rpx;
  font-weight: 600;
}

.captcha-btn.disabled {
  background: #d9d9d9;
  color: #999999;
}

/* ========== 搜索结果下拉 ========== */
.search-results {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid #e8e8e8;
  max-height: 400rpx;
  overflow-y: auto;
  z-index: 100;
}

.search-item {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
  transition: background 0.2s ease;
}

.search-item:last-child {
  border-bottom: none;
}

.search-item:active {
  background: #f8f9fa;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 4rpx;
}

.item-account {
  font-size: 24rpx;
  color: #666666;
}

.item-unit {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 表单按钮 ========== */
.form-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.binding-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.binding-btn.primary {
  background: linear-gradient(135deg, #1890ff, #40a9ff);
  color: #ffffff;
}

.binding-btn.loading {
  opacity: 0.7;
  transform: scale(0.98);
}

.binding-btn:active {
  transform: scale(0.95);
}

.btn-icon, .loading-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.loading-icon {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* ========== 绑定进度 ========== */
.binding-progress {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.progress-icon {
  margin-bottom: 40rpx;
}

.loading-spinner {
  font-size: 120rpx;
  animation: rotate 2s linear infinite;
}

.progress-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.progress-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.progress-desc {
  font-size: 26rpx;
  color: #666666;
}

/* ========== 底部区域 ========== */
.binding-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
  padding: 30rpx 40rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.footer-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.tips-icon {
  font-size: 24rpx;
  margin-right: 12rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #666666;
}

.footer-actions {
  display: flex;
  justify-content: center;
}

.footer-btn {
  background: #f5f5f5;
  color: #666666;
  border: none;
  border-radius: 20rpx;
  padding: 16rpx 40rpx;
  font-size: 26rpx;
}

.footer-btn.cancel {
  background: #fff2f0;
  color: #ff4d4f;
}

/* ========== 响应式适配 ========== */
@media (max-width: 750rpx) {
  .binding-container {
    padding-bottom: 100rpx;
  }
  
  .step-content {
    padding: 0 30rpx;
  }
  
  .binding-form {
    padding: 40rpx 30rpx;
  }
  
  .step-indicator {
    padding: 30rpx 40rpx 0;
  }
  
  .step-line {
    width: 80rpx;
    margin: 0 15rpx;
  }
}

/* ========== 深色模式适配 ========== */
@media (prefers-color-scheme: dark) {
  .binding-form,
  .binding-methods,
  .user-card {
    background: rgba(30, 30, 30, 0.95);
    border: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .form-title .title-text,
  .method-title .title-text,
  .method-name,
  .user-name,
  .progress-title {
    color: #ffffff;
  }
  
  .form-title .title-desc,
  .method-title .title-desc,
  .method-desc,
  .bind-desc,
  .progress-desc {
    color: rgba(255, 255, 255, 0.7);
  }
  
  .field-input {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }
  
  .field-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }
  
  .method-item {
    background: rgba(255, 255, 255, 0.1);
  }
  
  .search-results {
    background: #333333;
    border-color: rgba(255, 255, 255, 0.2);
  }
  
  .search-item {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  
  .item-name {
    color: #ffffff;
  }
  
  .item-account,
  .item-unit {
    color: rgba(255, 255, 255, 0.7);
  }
}
