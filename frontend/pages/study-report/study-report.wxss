/* pages/study-report/study-report.wxss */

.report-container {
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 日历样式 */
.calendar-section {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.calendar-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.month-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon {
  font-size: 32rpx;
  color: #666;
  font-weight: bold;
}

.current-month {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.calendar-grid {
  padding: 20rpx;
}

.weekday-header {
  display: flex;
  margin-bottom: 20rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

.calendar-body {
  display: flex;
  flex-wrap: wrap;
}

.calendar-day {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 8rpx;
  border-radius: 8rpx;
}

.calendar-day.other-month .day-number {
  color: #ccc;
}

.calendar-day.today {
  background: #e6f7ff;
}

.calendar-day.selected {
  background: #1890ff;
}

.calendar-day.selected .day-number {
  color: #fff;
}

.calendar-day.has-data {
  background: #f6ffed;
}

.calendar-day.has-data.selected {
  background: #1890ff;
}

.day-number {
  font-size: 28rpx;
  color: #333;
  line-height: 1;
}

.study-indicator {
  position: absolute;
  bottom: 2rpx;
  font-size: 18rpx;
}

.study-hours {
  color: #52c41a;
  font-weight: 500;
}

.calendar-day.selected .study-hours {
  color: rgba(255, 255, 255, 0.8);
}

/* 填报表单 */
.report-form {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.form-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.selected-date {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}

.form-content {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.time-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 12rpx;
  font-size: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.time-input:focus {
  border-color: #1890ff;
}

.form-tips {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.form-tips text {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.form-tips text:last-child {
  margin-bottom: 0;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff, #096dd9);
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 订阅提醒 */
.subscribe-section {
  margin-bottom: 20rpx;
}

.subscribe-card {
  background: linear-gradient(135deg, #fa8c16, #d46b08);
  color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.subscribe-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.subscribe-content {
  flex: 1;
}

.subscribe-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.subscribe-desc {
  font-size: 24rpx;
  opacity: 0.9;
}

.subscribe-btn {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
  font-size: 24rpx;
}

/* 历史记录 */
.history-section {
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.history-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.history-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-date {
  flex: 1;
}

.date-text {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.weekday-text {
  font-size: 24rpx;
  color: #999;
}

.history-time {
  text-align: center;
  margin-right: 30rpx;
}

.time-value {
  display: block;
  font-size: 32rpx;
  color: #1890ff;
  font-weight: 600;
  line-height: 1;
  margin-bottom: 4rpx;
}

.time-unit {
  font-size: 22rpx;
  color: #666;
}

.edit-indicator {
  width: 60rpx;
  text-align: center;
}

.edit-text {
  font-size: 24rpx;
  color: #1890ff;
}

.empty-history {
  background: #fff;
  border-radius: 16rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 统计信息 */
.stats-section {
  margin-bottom: 20rpx;
}

.stats-grid {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.stats-item {
  text-align: center;
  flex: 1;
}

.stats-value {
  display: block;
  font-size: 36rpx;
  color: #1890ff;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.stats-label {
  font-size: 24rpx;
  color: #666;
}
