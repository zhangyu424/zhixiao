/* pages/change-password-first/change-password-first.wxss */
.change-password-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 40rpx;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  margin-bottom: 30rpx;
}

.title-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 15rpx;
}

.title-desc {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-info {
  padding: 20rpx 30rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 30rpx;
  display: inline-block;
}

.welcome-text {
  font-size: 28rpx;
  color: #fff;
}

/* 表单 */
.form-container {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

.form-field {
  margin-bottom: 40rpx;
}

.form-field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  color: #333;
  box-sizing: border-box;
}

.field-input:focus {
  border-color: #667eea;
  background: #fff;
}

.field-input::placeholder {
  color: #adb5bd;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: #e9ecef;
  margin: 40rpx 0;
}

/* 验证码输入组 */
.code-input-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  width: 200rpx;
  height: 88rpx;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.code-btn:disabled {
  background: #ced4da;
  color: #6c757d;
}

.code-btn::after {
  border: none;
}

/* 提交区域 */
.submit-section {
  margin-top: 60rpx;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: #667eea;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: bold;
}

.submit-btn:disabled {
  background: #ced4da;
}

.submit-btn::after {
  border: none;
}

/* 安全提示 */
.security-tips {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 40rpx;
}

.tip-title {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.tip-title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.tip-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 2;
  margin-bottom: 10rpx;
}
