<!--pages/change-password-first/change-password-first.wxml-->
<view class="change-password-container">
  <!-- 头部 -->
  <view class="header">
    <view class="title">
      <text class="title-text">首次登录</text>
      <text class="title-desc">请修改密码并绑定手机号</text>
    </view>
    <view class="user-info" wx:if="{{userInfo}}">
      <text class="welcome-text">欢迎，{{userInfo.name || '用户'}}</text>
    </view>
  </view>

  <!-- 表单 -->
  <view class="form-container">
    <!-- 当前密码 -->
    <view class="form-field">
      <view class="field-label">当前密码</view>
      <input 
        class="field-input"
        placeholder="请输入当前密码"
        value="{{form.oldPassword}}"
        bindinput="onOldPasswordInput"
        password
        maxlength="20"
      />
    </view>

    <!-- 新密码 -->
    <view class="form-field">
      <view class="field-label">新密码</view>
      <input 
        class="field-input"
        placeholder="请输入新密码，至少6位"
        value="{{form.newPassword}}"
        bindinput="onNewPasswordInput"
        password
        maxlength="20"
      />
    </view>

    <!-- 确认新密码 -->
    <view class="form-field">
      <view class="field-label">确认新密码</view>
      <input 
        class="field-input"
        placeholder="请再次输入新密码"
        value="{{form.confirmPassword}}"
        bindinput="onConfirmPasswordInput"
        password
        maxlength="20"
      />
    </view>

    <view class="divider"></view>

    <!-- 手机号 -->
    <view class="form-field">
      <view class="field-label">绑定手机号</view>
      <input 
        class="field-input"
        placeholder="请输入要绑定的手机号"
        value="{{form.phone}}"
        bindinput="onPhoneInput"
        type="number"
        maxlength="11"
      />
    </view>

    <!-- 验证码 -->
    <view class="form-field">
      <view class="field-label">验证码</view>
      <view class="code-input-group">
        <input 
          class="field-input code-input"
          placeholder="请输入验证码"
          value="{{form.verificationCode}}"
          bindinput="onCodeInput"
          type="number"
          maxlength="6"
        />
        <button 
          class="code-btn"
          bindtap="sendVerificationCode"
          disabled="{{codeStatus.loading || codeStatus.countdown > 0}}"
          loading="{{codeStatus.loading}}"
        >
          {{codeStatus.text}}
        </button>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button 
        class="submit-btn"
        bindtap="submitChange"
        loading="{{submitLoading}}"
        disabled="{{submitLoading}}"
      >
        {{submitLoading ? '提交中...' : '确认修改'}}
      </button>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="security-tips">
    <view class="tip-title">
      <text class="tip-icon">🔒</text>
      <text class="tip-title-text">安全提醒</text>
    </view>
    <text class="tip-text">• 首次登录必须修改密码并绑定手机号</text>
    <text class="tip-text">• 新密码需要至少6位字符</text>
    <text class="tip-text">• 手机号用于密码找回和安全验证</text>
    <text class="tip-text">• 修改完成后需要重新登录</text>
  </view>
</view>
